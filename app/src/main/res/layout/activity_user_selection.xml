<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/buttonMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="@string/menu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/skolan_app"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/buttonNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_dialog_info"
                android:contentDescription="@string/notifications" />

        </LinearLayout>


        <ScrollView
            android:id="@+id/mainScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nestedScrollingEnabled="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:fillViewport="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <ImageButton
                            android:id="@+id/buttonTeacherEmail"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="12dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_dialog_email"
                            android:contentDescription="@string/larare_email"
                            android:scaleType="centerInside" />

                        <ImageButton
                            android:id="@+id/buttonParentsEmail"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="12dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_dialog_email"
                            android:contentDescription="@string/foraldrar_email"
                            android:scaleType="centerInside" />

                        <ImageButton
                            android:id="@+id/buttonBirthdays"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="12dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_menu_my_calendar"
                            android:contentDescription="@string/fodelsedagar"
                            android:scaleType="centerInside" />

                        <ImageButton
                            android:id="@+id/buttonCalendar"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="12dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_menu_today"
                            android:contentDescription="@string/kalender"
                            android:scaleType="centerInside" />

                    </LinearLayout>

                </HorizontalScrollView>

                <include
                    android:id="@+id/newsLayout"
                    layout="@layout/activity_news" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/senaste"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/valkommen_till_skolan_app"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:text="@string/fodelsedagar"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textNextBirthday"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Nästa födelsedag: Thomas Lövkvist – 30 september"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/buttonViewBirthdays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/las_mer" />


                <TextView
                    android:id="@+id/sectionCalendar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:text="@string/kalender"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textNextActivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text=""
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/buttonReadCalendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/las_mer" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <include
        android:id="@+id/drawerMenu"
        layout="@layout/drawer_menu_side" />

</androidx.drawerlayout.widget.DrawerLayout>