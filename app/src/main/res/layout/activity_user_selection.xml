<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/buttonMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:contentDescription="@string/menu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/skolan_app"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/buttonNotifications"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_dialog_info"
                android:contentDescription="@string/notifications" />

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:fillViewport="false">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp">

                        <ImageButton
                            android:id="@+id/buttonTeacherEmail"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="12dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_dialog_email"
                            android:contentDescription="@string/larare_email"
                            android:scaleType="centerInside" />


                        <ImageButton
                            android:id="@+id/buttonParentsEmail"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="12dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_dialog_email"
                            android:contentDescription="@string/foraldrar_email"
                            android:scaleType="centerInside" />

                        <ImageButton
                            android:id="@+id/buttonBirthdays"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="12dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_menu_my_calendar"
                            android:contentDescription="@string/fodelsedagar"
                            android:scaleType="centerInside" />

                        <ImageButton
                            android:id="@+id/buttonCalendar"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="12dp"
                            android:background="@android:color/transparent"
                            android:src="@android:drawable/ic_menu_today"
                            android:contentDescription="@string/kalender"
                            android:scaleType="centerInside" />

                    </LinearLayout>

                </HorizontalScrollView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/nyheter"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/senaste"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/valkommen_till_skolan_app"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="35dp"
                    android:text="@string/fodelsedagar"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Thomas Lövkvist"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="30 september"
                    android:textSize="16sp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@android:color/white">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/skolan_app"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menuHome"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/hem"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/menuNews"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/nyheter"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/menuBirthdays"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/fodelsedagar"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/menuCalendar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/kalender"
            android:textSize="18sp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>